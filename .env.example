# ==============================
# App
# ==============================
NODE_ENV=development
PORT=3000
RUN_SEED=false

# ==============================
# Database (Prisma 7.8.0 + @prisma/adapter-pg)
# ==============================
DATABASE_URL=

# ==============================
# SEEDING CREDENTIALS
# ==============================
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ==============================
# JWT
# ==============================
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==============================
# Google OAuth (login Gmail institusi)
# ==============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Domain Gmail institusi yang diizinkan login (dipakai buat validasi domain di auth.service)
GOOGLE_ALLOWED_HD=student.smktelkom-mlg.sch.id

# ==============================
# OTP
# ==============================
OTP_LENGTH=
OTP_TTL_SECONDS=
OTP_MAX_REQUESTS_PER_WINDOW=
OTP_WINDOW_SECONDS=

# ==============================
# Throttler (rate limiting global, dipakai juga oleh OTP endpoint)
# ==============================
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# ==============================
# Cloudinary
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_FILE_SIZE=

# ==============================
# SMTP (pengiriman kode OTP via email)
# ==============================
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ==============================
# CORS
# ==============================
FRONTEND_URL=*